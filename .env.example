# Environment variables (names only — never commit values). Inventory: project-docs-workthrough/08 §9.
# Validated at boot by lib/server/env.ts; a misconfigured process refuses to start.
# Copy to .env.local for local development. Staging and production values live in the host's secret store.

# --- Phase 0: app and security --------------------------------------------------------------
# local | test | staging | production. Staging and production require HTTPS origins,
# TRUST_PROXY_MODE=cloudflare and an origin secret.
APP_ENV=
# Canonical origin, e.g. https://app.example.com (defaults to http://localhost:3000 locally).
NEXT_PUBLIC_APP_ORIGIN=
# Comma-separated origins accepted on mutating API requests (CSRF check). Defaults to NEXT_PUBLIC_APP_ORIGIN.
APP_ALLOWED_ORIGINS=
# none (local) | cloudflare (staging, production). "cloudflare" turns on the origin lock.
TRUST_PROXY_MODE=
# Origin lock secret set by the Cloudflare Transform Rule (≥ 32 random characters). PREVIOUS is for rotation.
ORIGIN_SHARED_SECRET=
ORIGIN_SHARED_SECRET_PREVIOUS=
# Tests only: honour X-Test-Client-IP. A production build refuses to start if this is 1.
ALLOW_TEST_CLIENT_IP=
# Tests and local development only (needs ALLOW_TEST_CLIENT_IP=1): the client IP assumed when a
# request has no X-Test-Client-IP, so local browsers share one simulated network.
TEST_CLIENT_IP_DEFAULT=
# debug | info | warn | error
LOG_LEVEL=
# Kill switches are cached at most this many seconds (default 30, 03 §10).
RUNTIME_FLAGS_CACHE_SECONDS=

# --- Phase 0 foundation, used from Phase 1: database ----------------------------------------
# app_server through the Supavisor pooler (session mode). Local: see `pnpm exec supabase status`.
DATABASE_URL=

# --- Phase 0 foundation, used from Phase 1: Supabase (all or none) --------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- Phase 0 foundation, used from Phase 1: Cloudflare R2 (all or none) ---------------------
R2_ACCOUNT_ID=
R2_BUCKET=
# Exact S3 endpoint, e.g. https://<account-id>.r2.cloudflarestorage.com (also used in the CSP)
R2_S3_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Phase 1: local sharing (all required in staging and production) -----------------------
# Turnstile site key. Supabase Auth verifies the anonymous sign-in token with the secret key set in
# its captcha settings; from Phase 2 the server also verifies its own challenges (TURNSTILE_SECRET_KEY).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Network keys (DEC-032): HMAC secret (≥ 32 random characters). PREVIOUS only during rotation,
# with NETWORK_KEY_VERSION raised by one.
NETWORK_KEY_SECRET_CURRENT=
NETWORK_KEY_SECRET_PREVIOUS=
NETWORK_KEY_VERSION=
# IPv6 grouping prefix (default 64). The large-network cap is the runtime flag
# app.runtime_flags('network_large_cap'), not an environment variable.
NETWORK_IPV6_PREFIX_LEN=
# Local stack: `pnpm stack:env > .env.local` prints working local values for all of the above.

# --- Phase 2: remote links, short codes, abuse reports (all required in staging and production)
# HMAC keys for link secrets and short codes (≥ 32 random characters each, and different).
# PREVIOUS only during rotation, with PEPPER_VERSION raised by one.
LINK_PEPPER=
LINK_PEPPER_PREVIOUS=
CODE_PEPPER=
CODE_PEPPER_PREVIOUS=
PEPPER_VERSION=
# Turnstile secret key: the server verifies challenges for code guessing and abuse reports. The
# same key is also set in the Supabase project's Auth captcha settings (anonymous sign-in).
TURNSTILE_SECRET_KEY=
# Tests and local development only: a stand-in for Cloudflare's siteverify endpoint.
TURNSTILE_VERIFY_URL=

# --- Phase 4 --------------------------------------------------------------------------------
INVITE_PEPPER=
# BILLING_* variables are added with the chosen provider (Q-005).

# --- Only for multi-instance deployments ----------------------------------------------------
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
